    -- 雙踢模式（連續飛抓雙人 ➔ 攜帶兩人飛回原位 ➔ 巨人俯視45度 ➔ 雙手同步打擊）
    local dualKickEnabled, dualKickThread = false, nil
    local function toggleDualKick(on)
        if dualKickThread then task.cancel(dualKickThread) dualKickThread = nil end
        dualKickEnabled = on
        if not on then return end

        dualKickThread = task.spawn(function()
            local GE = ReplicatedStorage:WaitForChild("GrabEvents")
            local packetTimer = 0
            local SavedPos = nil

            while dualKickEnabled do
                local blob, blobRoot = GKLib.EnsureReadyForKick(SavedPos)
                if not blob or not blobRoot then
                    task.wait(0.5)
                else
                    if not SavedPos then SavedPos = blobRoot.CFrame end
                    local leftTarget = selectedLeftTarget
                    local rightTarget = selectedRightTarget

                    if not GKLib.IsTargetValid(leftTarget) and not GKLib.IsTargetValid(rightTarget) then
                        task.wait(0.2)
                    else
                        local scriptObj = blob:FindFirstChild("BlobmanSeatAndOwnerScript")
                        local CG = scriptObj and scriptObj:FindFirstChild("CreatureGrab")
                        local CD = scriptObj and scriptObj:FindFirstChild("CreatureDrop")
                        local R_Det = blob:FindFirstChild("RightDetector")
                        local L_Det = blob:FindFirstChild("LeftDetector")

                        local leftRoot = GKLib.IsTargetValid(leftTarget) and leftTarget.Character:FindFirstChild("HumanoidRootPart")
                        local rightRoot = GKLib.IsTargetValid(rightTarget) and rightTarget.Character:FindFirstChild("HumanoidRootPart")

                        local needFetchLeft = leftRoot and (leftRoot.Position - SavedPos.Position).Magnitude > 20
                        local needFetchRight = rightRoot and (rightRoot.Position - SavedPos.Position).Magnitude > 20

                        -- 1. 先飛去抓【左手目標】
                        if needFetchLeft then
                            GKLib.GrabTargetAtPos(blobRoot, leftTarget, CG, GE, L_Det, function() return dualKickEnabled end)
                        end

                        -- 2. 緊接著飛去抓【右手目標】
                        if needFetchRight then
                            GKLib.GrabTargetAtPos(blobRoot, rightTarget, CG, GE, R_Det, function() return dualKickEnabled end)
                        end

                        -- 3. 兩人都抓完後，帶著名單上的目標一起【飛回原位】，並套用俯視 45 度
                        if needFetchLeft or needFetchRight then
                            local _, yAngle, _ = SavedPos:ToOrientation()
                            local tiltedCF = CFrame.new(SavedPos.Position) * CFrame.Angles(math.rad(45), yAngle, 0)
                            GKLib.ApplyCFrame(blobRoot, tiltedCF)
                            task.wait(0.01)
