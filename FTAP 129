    local sprayAntiKickEnabled, sprayAntiKickThread = false, nil
    local function toggleSprayCanAntiKick(on)
        if sprayAntiKickThread then task.cancel(sprayAntiKickThread) sprayAntiKickThread = nil end
        sprayAntiKickEnabled = on
        if not on then return end

        sprayAntiKickThread = task.spawn(function()
            while sprayAntiKickEnabled do
                -- 判斷當前是否為雙踢模式且左右目標皆有效
                if selectedKickMode == "雙踢模式" and (GKLib.IsTargetValid(selectedLeftTarget) or GKLib.IsTargetValid(selectedRightTarget)) then
                    local leftTarget = selectedLeftTarget
                    local rightTarget = selectedRightTarget

                    -- 準備兩個噴漆罐（或重複利用兩個來分別對應左手與右手目標）
                    local can1 = GKLib.getToy("SprayCanWD") or GKLib.getToy("SprayCan") or GKLib.spawnToy("SprayCanWD")
                    local can2 = GKLib.getToy("SprayCanWD") or GKLib.getToy("SprayCan") or GKLib.spawnToy("SprayCanWD")

                    local canPart1 = can1 and (can1:IsA("BasePart") and can1 or can1:FindFirstChild("Handle") or can1:FindFirstChildWhichIsA("BasePart") or can1.PrimaryPart)
                    local canPart2 = can2 and (can2:IsA("BasePart") and can2 or can2:FindFirstChild("Handle") or can2:FindFirstChildWhichIsA("BasePart") or can2.PrimaryPart)

                    if canPart1 or canPart2 then
                        local pitchSpeed, pitchAngleRange = 10, math.rad(40)
                        while sprayAntiKickEnabled and selectedKickMode == "双踢模式" and (GKLib.IsTargetValid(selectedLeftTarget) or GKLib.IsTargetValid(selectedRightTarget)) do
                            local t = tick() * pitchSpeed
                            local pitch = math.sin(t) * pitchAngleRange

                            -- 防護左手目標
                            if GKLib.IsTargetValid(leftTarget) and canPart1 and can1.Parent then
                                GKLib.SetNetworkOwner(canPart1)
                                local lRoot = leftTarget.Character and leftTarget.Character:FindFirstChild("HumanoidRootPart")
                                if lRoot then
                                    local backPos = lRoot.Position - (lRoot.CFrame.LookVector * 2.5) + Vector3.new(0, 0.5, 0)
                                    GKLib.ApplyCFrame(canPart1, CFrame.lookAt(backPos, lRoot.Position) * CFrame.Angles(pitch, 0, 0))
                                    GKLib.SetNetworkOwner(canPart1)
                                end
                            end

                            -- 防護右手目標
                            if GKLib.IsTargetValid(rightTarget) and canPart2 and can2.Parent then
                                GKLib.SetNetworkOwner(canPart2)
                                local rRoot = rightTarget.Character and rightTarget.Character:FindFirstChild("HumanoidRootPart")
                                if rRoot then
                                    local backPos = rRoot.Position - (rRoot.CFrame.LookVector * 2.5) + Vector3.new(0, 0.5, 0)
                                    GKLib.ApplyCFrame(canPart2, CFrame.lookAt(backPos, rRoot.Position) * CFrame.Angles(pitch, 0, 0))
                                    GKLib.SetNetworkOwner(canPart2)
                                end
                            end

                            RunService.Heartbeat:Wait()
                        end
                    else
                        task.wait(0.2)
                    end
                else
                    -- 單人模式防踢邏輯
                    local target = selectedTargetPlayer
                    if not GKLib.IsTargetValid(target) then
                        task.wait(0.5)
                    else
                        local can = GKLib.getToy("SprayCanWD") or GKLib.getToy("SprayCan") or GKLib.spawnToy("SprayCanWD")
                        local canPart = can and (can:IsA("BasePart") and can or can:FindFirstChild("Handle") or can:FindFirstChildWhichIsA("BasePart") or can.PrimaryPart)
                        if canPart then
                            GKLib.SetNetworkOwner(canPart)
                            local pitchSpeed, pitchAngleRange = 10, math.rad(40)
                            while sprayAntiKickEnabled and GKLib.IsTargetValid(selectedTargetPlayer) and selectedTargetPlayer == target and can and can.Parent do
                                local tRoot = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
                                if not tRoot then break end

                                local backPos = tRoot.Position - (tRoot.CFrame.LookVector * 2.5) + Vector3.new(0, 0.5, 0)
                                local baseCF = CFrame.lookAt(backPos, tRoot.Position)
                                local pitch = math.sin(tick() * pitchSpeed) * pitchAngleRange
                                
                                GKLib.ApplyCFrame(canPart, baseCF * CFrame.Angles(pitch, 0, 0))
                                GKLib.SetNetworkOwner(canPart)
                                RunService.Heartbeat:Wait()
                            end
                        else
                            task.wait(0.2)
                        end
                    end
                end
            end
        end)
    end

