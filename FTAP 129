    local seat = FindChildSafe(blob, "VehicleSeat")
    local ragdollRemote = ReplicatedStorage:FindFirstChild("CharacterEvents") and ReplicatedStorage.CharacterEvents:FindFirstChild("RagdollRemote")

    task.spawn(function()
