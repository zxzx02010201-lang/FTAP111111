local function equipKatanaWithMotor(equip)
    local char = localPlayer.Character
    if not char then return end
    
    local rightHand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
    local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("HumanoidRootPart")
    
    local userToysFolder = Workspace:FindFirstChild(localPlayer.Name .. "SpawnedInToys")
    local katana = userToysFolder and userToysFolder:FindFirstChild("NinjaKatana")
    local sticky = katana and katana:FindFirstChild("StickyPart")
    
    if not sticky then return end
    
    local playerEvents = game:GetService("ReplicatedStorage"):FindFirstChild("PlayerEvents")
    local stickyEvent = playerEvents and playerEvents:FindFirstChild("StickyPartEvent")
    if not stickyEvent then return end

    -- 移除舊的 Motor6D（如果有的話）
    if currentKatanaMotor then
        currentKatanaMotor:Destroy()
        currentKatanaMotor = nil
    end

    if equip then
        -- 1. 先用 StickyEvent 把刀子貼到右手
        stickyEvent:FireServer(sticky, rightHand, CFrame.new())
        task.wait(0.1)

        -- 2. 拔除原本的 StickyWeld，改用我們自定義的 Motor6D
        local weld = sticky:FindFirstChild("StickyWeld")
        if weld then weld:Destroy() end

        -- 建立 Motor6D 連接右手與 StickyPart
        local motor = Instance.new("Motor6D")
        motor.Name = "KatanaMotor"
        motor.Part0 = rightHand
        motor.Part1 = sticky
        
        -- 調整手持姿勢與刀柄插入點
        motor.C0 = CFrame.new(0, -1, 0) * CFrame.Angles(math.rad(-90), math.rad(0), math.rad(0))
        motor.Parent = rightHand
        
        currentKatanaMotor = motor
        isEquipped = true
    else
        -- 收回腰間
        local beltOffset = CFrame.new(1.2, -1.5, 1.5) * CFrame.Angles(math.rad(-50), 0, math.rad(90))
        stickyEvent:FireServer(sticky, torso, beltOffset)
        isEquipped = false
    end
end

-- 揮砍動作函數
local function slashKatana()
    local char = localPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    -- 播放揮刀動畫
    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://522635514" 
    local track = hum:LoadAnimation(anim)
    track:Play()

    -- 利用 Motor6D 在揮砍時短暫旋轉手部/刀子做出動態砍擊手感
    if currentKatanaMotor then
        task.spawn(function()
            local originalC0 = currentKatanaMotor.C0
            currentKatanaMotor.C0 = originalC0 * CFrame.Angles(math.rad(45), math.rad(30), 0)
            task.wait(0.2)
            currentKatanaMotor.C0 = originalC0
        end)
    end

    -- 範圍傷害判定
    local root = char:FindFirstChild("HumanoidRootPart")
    if root then
        for _, otherChar in ipairs(Workspace:GetChildren()) do
            if otherChar:IsA("Model") and otherChar ~= char then
                local otherHum = otherChar:FindFirstChildOfClass("Humanoid")
                local otherRoot = otherChar:FindFirstChild("HumanoidRootPart")
                if otherHum and otherRoot then
                    local dist = (otherRoot.Position - root.Position).Magnitude
                    if dist <= 7 then
                        pcall(function()
                            otherHum:TakeDamage(25)
                        end)
                    end
                end
            end
        end
    end
end

