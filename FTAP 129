-- 啟動/停止配刀的內部函數 (腰間自動配戴)
local function setKatanaActive(state)
    if not state then
        if katanaLoop then
            task.cancel(katanaLoop)
            katanaLoop = nil
        end
        
        local userToysFolder = Workspace:FindFirstChild(localPlayer.Name .. "SpawnedInToys")
        if userToysFolder then
            local oldKatana = userToysFolder:FindFirstChild("NinjaKatana")
            if oldKatana then
                oldKatana:Destroy()
            end
        end
        return
    end

    if katanaLoop then return end

    katanaLoop = task.spawn(function()
        while config.autoKatana do
            local char = localPlayer.Character
            local targetPart = char and (char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("HumanoidRootPart"))
            local root = char and char:FindFirstChild("HumanoidRootPart")

            if char and targetPart and root then
                local KatanaName = "NinjaKatana"
                local userToysFolder = Workspace:FindFirstChild(localPlayer.Name .. "SpawnedInToys")
                local katana = userToysFolder and userToysFolder:FindFirstChild(KatanaName)

                local sticky = katana and katana:FindFirstChild("StickyPart")
                local weld = sticky and sticky:FindFirstChild("StickyWeld")
                
                local isStolen = false
                if weld and weld.Part1 ~= nil and weld.Part1 ~= targetPart and not isEquipped then
                    isStolen = true
                end

                local isAttached = (weld and weld.Part1 == targetPart)

                if (not katana or not isAttached or isStolen) and not isEquipped then
                    if katana then
                        pcall(function()
                            katana:Destroy()
                        end)
                        task.wait(0.2)
                    end

                    local canSpawn = localPlayer:FindFirstChild("CanSpawnToy")
                    if canSpawn and canSpawn.Value then
                        local menuToys = game:GetService("ReplicatedStorage"):FindFirstChild("MenuToys")
                        local spawnRmt = menuToys and menuToys:FindFirstChild("SpawnToyRemoteFunction")

                        if spawnRmt then
                            pcall(function()
                                local spawnCF = root.CFrame * CFrame.new(0, 2, -5)
                                spawnRmt:InvokeServer(tostring(KatanaName), spawnCF, Vector3.zero)
                            end)
                            task.wait(0.4)
                            userToysFolder = Workspace:FindFirstChild(localPlayer.Name .. "SpawnedInToys")
                            katana = userToysFolder and userToysFolder:FindFirstChild(KatanaName)
                        end
                    end

                    if katana then
                        for _, part in ipairs(katana:GetDescendants()) do
                            if part:IsA("BasePart") then
                                part.CanTouch = false
                                part.CanCollide = false
                                part.CanQuery = false
                                part.AssemblyLinearVelocity = Vector3.zero
                                part.AssemblyAngularVelocity = Vector3.zero
                            end
                        end

                        sticky = katana:WaitForChild("StickyPart", 2)
                        if sticky then
                            local grabEvents = game:GetService("ReplicatedStorage"):FindFirstChild("GrabEvents")
                            local setNetwork = grabEvents and grabEvents:FindFirstChild("SetNetworkOwner")
                            if setNetwork then
                                pcall(function()
                                    setNetwork:FireServer(sticky, sticky.CFrame)
                                end)
                            end

                            -- 腰間佩戴位置
                            local katanaOffset = CFrame.new(1.2, -1.5, 1.5) 
                                * CFrame.Angles(math.rad(-50), math.rad(0), math.rad(90))

                            local playerEvents = game:GetService("ReplicatedStorage"):FindFirstChild("PlayerEvents")
                            local stickyEvent = playerEvents and playerEvents:FindFirstChild("StickyPartEvent")

                            local retry = 0
                            while stickyEvent and retry < 15 and config.autoKatana and not isEquipped do
                                stickyEvent:FireServer(sticky, targetPart, katanaOffset)
                                task.wait(0.1)
                                weld = sticky:FindFirstChild("StickyWeld")
                                if weld and weld.Part1 == targetPart then break end
                                retry = retry + 1
                            end
                        end
                    end
                end
            end

            task.wait(0.5)
        end
    end)
end

