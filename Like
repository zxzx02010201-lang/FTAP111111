local function new(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props) do
        o[k] = v
    end
    if parent then
        o.Parent = parent
    end
    return o
end

local function corner(o, r)
    return new("UICorner", { CornerRadius = r or UDim.new(0, 6) }, o)
end

local function stroke(o, col, th)
    return new("UIStroke", {
        Color = col or RED,
        Thickness = th or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, o)
end

local function circle(size, col, parent)
    local f = new("Frame", {
        Size = UDim2.fromOffset(size, size),
        BackgroundColor3 = col,
        BorderSizePixel = 0,
    }, parent)
    corner(f, UDim.new(1, 0))
    return f
end

local function rect(w, h, x, y, col, parent)
    return new("Frame", {
        Size = UDim2.fromOffset(w, h),
        Position = UDim2.fromOffset(x, y),
        BackgroundColor3 = col,
        BorderSizePixel = 0,
    }, parent)
end

local function text(parent, str, size, col, font)
    return new("TextLabel", {
        BackgroundTransparency = 1,
        Text = str,
        TextSize = size,
        TextColor3 = col or Color3.new(1, 1, 1),
        Font = font or Enum.Font.GothamBold,
        BorderSizePixel = 0,
    }, parent)
end

local function tween(o, t, props, style, dir)
    local ok, tw = pcall(function()
        return TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
    end)
    if ok and tw then
        tw:Play()
        return tw
    end
end

