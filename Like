    local OV = { alive = true, conns = {} }

    local function new(class, props, parent)
        local o = Instance.new(class)
        for k, v in pairs(props) do
            o[k] = v
        end
        if parent then
            o.Parent = parent
        end
        return o
    end

    local function corner(o, r)
        return new("UICorner", { CornerRadius = UDim.new(0, r or 6) }, o)
    end

    local function stroke(o, col, th)
        return new("UIStroke", {
            Color = col,
            Thickness = th or 1,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        }, o)
    end

    local function label(parent, str, size, col, x, y, w, h, align, font)
        return new("TextLabel", {
            BackgroundTransparency = 1,
            Text = str,
            TextSize = size,
            TextColor3 = col or WHITE,
            Font = font or Enum.Font.GothamBold,
            BorderSizePixel = 0,
            Position = UDim2.fromOffset(x, y),
            Size = UDim2.fromOffset(w, h),
            TextXAlignment = align or Enum.TextXAlignment.Left,
        }, parent)
    end

    local function rect(parent, x, y, w, h, col)
        return new("Frame", {
            Position = UDim2.fromOffset(x, y),
            Size = UDim2.fromOffset(w, h),
            BackgroundColor3 = col,
            BorderSizePixel = 0,
        }, parent)
    end

    local function track(c)
        table.insert(OV.conns, c)
        return c
    end

    local function tween(o, t, props)
        local ok, tw = pcall(function()
            return TweenService:Create(o, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
        end)
        if ok and tw then
            tw:Play()
            return tw
        end
    end

    local function rnd(a, b)
        return math.random(a, b)
    end

    local parent
