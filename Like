            A.base = Vector2.new(70, 205)
            A.ah.Position = UDim2.fromOffset(70, 205)
            A.pop("TP BACK", 70, 100, PINK, 12)
            task.delay(0.25, function()
                if not A.alive then return end
                A.base = Vector2.new(170, 205)
                A.ah.Position = UDim2.fromOffset(170, 205)
            end)
        else
            A.ping.Text = "ping 99999ms"
            A.ping.TextColor3 = RED
            task.delay(1.2, function()
                if A.ping then
                    A.ping.Text = "ping " .. S.ping .. "ms"
                    A.ping.TextColor3 = PINK
                end
            end)
        end
