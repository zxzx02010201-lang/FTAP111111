local pesp = { inst = {}, conns = {} }
local function setPlayerESP(on)
    for _, i in ipairs(pesp.inst) do i:Destroy() end
    for _, c in ipairs(pesp.conns) do c:Disconnect() end
    pesp.inst, pesp.conns = {}, {}
    if not on then return end
    local function attach(p)
        if p == LocalPlayer then return end
        local function onChar(c)
            if removed[p] then return end
            local head = c:WaitForChild("Head", 5)
            if not head or not pesp.conns[1] then return end
            local hl = Instance.new("Highlight")
            hl.FillColor, hl.OutlineColor = ACCENT, Color3.new(1, 1, 1)
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Adornee = c hl.Parent = c
            local bb = Instance.new("BillboardGui")
            bb.Adornee, bb.AlwaysOnTop = head, true
            bb.Size, bb.StudsOffset = UDim2.fromOffset(200, 40), Vector3.new(0, 2.5, 0)
            bb.Parent = c
            local tl = Instance.new("TextLabel", bb)
            tl.BackgroundTransparency, tl.Size = 1, UDim2.fromScale(1, 1)
            tl.Text, tl.TextColor3, tl.TextStrokeTransparency = fmt(p), Color3.new(1, 1, 1), 0
            tl.Font, tl.TextSize = Enum.Font.GothamBold, 13
            table.insert(pesp.inst, hl) table.insert(pesp.inst, bb)
        end
        if p.Character then task.spawn(onChar, p.Character) end
        table.insert(pesp.conns, p.CharacterAdded:Connect(onChar))
    end
    table.insert(pesp.conns, Players.PlayerAdded:Connect(attach))
    for _, p in ipairs(Players:GetPlayers()) do attach(p) end
end

local espState = {}
local function trackESP(key, on, match, adornee, color)
    local st = espState[key]
    if st then
        for _, i in ipairs(st.inst) do i:Destroy() end
        st.conn:Disconnect()
        espState[key] = nil
    end
    if not on then return end
    st = { inst = {} }
    local function add(d)
        if not match(d) then return end
        local a = adornee(d)
        if not a then return end
        local hl = Instance.new("Highlight")
        hl.FillColor, hl.OutlineColor = color, Color3.new(1, 1, 1)
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Adornee = a hl.Parent = a
        table.insert(st.inst, hl)
    end
    for _, d in ipairs(workspace:GetDescendants()) do add(d) end
    st.conn = workspace.DescendantAdded:Connect(function(d) task.defer(add, d) end)
    espState[key] = st
end

