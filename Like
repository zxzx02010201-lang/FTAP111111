        if name == "Skid Hoodie" then
            A.torso.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
            A.torsoT.Text = "SKID"
            A.hood.Visible = true
        elseif name == "Sweaty Tryhard" then
            A.torso.BackgroundColor3 = Color3.fromRGB(150, 150, 170)
            A.torsoT.Text = "TRY"
