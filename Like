        for i = 1, 4 do
            rect(scr, 0, i * 23, 196, 1, Color3.fromRGB(10, 40, 20))
        end
        local COLS = 48
        local cols = {}
        local buf = {}
        for i = 1, COLS do
            cols[i] = rect(scr, (i - 1) * 4, 58, 4, 3, GREEN)
            buf[i] = 0
        end
        label(VB, "HR", 11, Color3.fromRGB(120, 200, 150), 214, 6, 90, 14)
