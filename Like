local function tintIcons()
    local sg = Library.ScreenGui
    if not sg then return end
    for _, d in ipairs(sg:GetDescendants()) do
        if d:IsA("ImageLabel") and string.find(tostring(d.Image), ICON_ID, 1, true) then
            d.ImageColor3 = RED
        end
    end
end

task.spawn(function()
    while A.alive and not Library.Unloaded do
        pcall(tintIcons)
        task.wait(1.5)
    end
end)

