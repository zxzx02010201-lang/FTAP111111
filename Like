    function A.lineIn(parent, x1, y1, x2, y2, th, col, z)
        local dx, dy = x2 - x1, y2 - y1
        return new("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy) + 1, th),
            Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2),
            Rotation = math.deg(math.atan2(dy, dx)),
            BackgroundColor3 = col,
            BorderSizePixel = 0,
            ZIndex = z or 9,
        }, parent)
end

    function A.setLine(f, x1, y1, x2, y2)
        local dx, dy = x2 - x1, y2 - y1
        f.Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy) + 1, f.Size.Y.Offset)
        f.Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2)
        f.Rotation = math.deg(math.atan2(dy, dx))
end

