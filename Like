function A.attackBall(roll)
    if not A.sb then return end
    if roll and not A.rolling then
        A.rolling = true
        local dur = math.clamp(0.9 - SW.speed * 0.06, 0.25, 0.85)
        tween(A.sb, dur, { Position = UDim2.fromOffset(A.base.X + 60, A.ballBase.Y) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        tween(A.ball, dur, { Rotation = -720 })
        task.delay(dur, function()
            if not A.alive then return end
            A.hit(wr(26, 46), "-" .. wr(30, 99) .. " BALL")
            A.shakeRoot(3, 0.2)
            if A.sb then
                tween(A.sb, 0.5, { Position = UDim2.fromOffset(A.ballBase.X, A.ballBase.Y) }, Enum.EasingStyle.Back)
                A.ball.Rotation = 0
            end
            task.delay(0.55, function() A.rolling = false end)
        end)
    else
        local dmg = wr(12, 26)
        A.fire(A.ballBase.X - 20, A.ballBase.Y - 14, A.base.X, A.base.Y - 70, SW.snowColor, A.travel(), function()
            A.hit(dmg)
        end, true)
    end
end

