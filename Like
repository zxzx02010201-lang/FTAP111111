    function A.hit(dmg, label)
        if not A.alive or A.crashed then return end
        dmg = math.floor(dmg * A.diffMul())
        if S.immunity then
            dmg = dmg * 2
            label = "IMMUNITY X  -" .. dmg
        end
        if A.umbUp and S.umbrella then
            A.umbUp = false
            A.umb.Visible = false
            A.pop("UMBRELLA.EXE STOPPED", A.base.X, A.base.Y - 140, PINK, 12)
            A.speak(A.figAh, "my anti-snowball umbrella!!")
        end
        A.hits = A.hits + 1
        A.setCred(A.hp - dmg)
        A.face.Text = ">_<"
        A.shakeAhmad(math.clamp(4 + math.floor(dmg / 4), 4, 14), 0.3)
        A.pop(label or ("-" .. dmg), A.base.X, A.base.Y - 100, WHITE, 16)
        A.gasp(2)
        A.lagFx()
        task.delay(0.3, function()
            if A.face and not A.crashed then A.face.Text = "O_O" end
        end)
        if A.hp <= 0 then
            A.convict()
        end
end

