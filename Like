function A.setFlakes(n)
    local f = A.flakes
    while #f > n do
        local o = table.remove(f)
        o.f:Destroy()
    end
    while #f < n do
        local sz = wr(2, 5)
        local fl = circle(sz, SW.snowColor, A.stage)
        fl.Position = UDim2.fromOffset(wr(0, A.W), wr(0, A.H))
        fl.ZIndex = 1
        table.insert(f, { f = fl, v = wr(18, 50), d = (math.random() - 0.5) * 20 })
    end
end

function A.recolor()
    for _, o in ipairs(A.flakes) do
        o.f.BackgroundColor3 = SW.snowColor
    end
    if A.ball then A.ball.BackgroundColor3 = SW.snowColor end
    if A.ground then A.ground.BackgroundColor3 = SW.snowColor end
end

function A.start()
    A.build()
    A.setFlakes(SW.snowCount)

    track(RunService.Heartbeat:Connect(function(dt)
        for _, o in ipairs(A.flakes) do
            local p = o.f.Position
            local y = p.Y.Offset + o.v * dt
            local x = p.X.Offset + o.d * dt
            if y > A.H then
                y = -6
                x = wr(0, A.W)
            end
            o.f.Position = UDim2.fromOffset(x, y)
        end
        if A.ball and not A.rolling then
            A.sb.Position = UDim2.fromOffset(A.ballBase.X, A.ballBase.Y + math.sin(os.clock() * 4) * 3)
        end
        if A.stroke then
            local k = (math.sin(os.clock() * 3) + 1) / 2
            A.stroke.Color = Color3.fromRGB(150 + math.floor(105 * k), 20, 20)
        end
    end))

    task.spawn(function()
        while A.alive do
            if SW.auto and A.root and A.root.Visible and not A.crashed then
                A.battleStep()
            end
            task.wait(1 / math.max(SW.rate, 0.5) + 0.25)
        end
    end)

    task.spawn(function()
        while A.alive do
            task.wait(3)
            A.bannerIdx = A.bannerIdx % #BANNERS + 1
            local b = BANNERS[A.bannerIdx]
