    function A.setLine(f, x1, y1, x2, y2, th)
        local dx, dy = x2 - x1, y2 - y1
        f.Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy) + 1, th or f.Size.Y.Offset)
        f.Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2)
        f.Rotation = math.deg(math.atan2(dy, dx))
    end

    function A.line(x1, y1, x2, y2, th, col)
        local f = new("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            BackgroundColor3 = col,
            BorderSizePixel = 0,
            ZIndex = 9,
        }, A.stage)
        A.setLine(f, x1, y1, x2, y2, th)
        return f
    end

