local function PlayerList(box, text)
    local dd = box:AddDropdown(id("PL"), {
        Text = text or "Targets", SpecialType = "Player", ExcludeLocalPlayer = true,
        Multi = true, AllowNull = true, Searchable = true, EnablePlayerImages = true,
        Values = {}, Callback = function(val)
            for p, on in pairs(val) do
                if on and typeof(p) == "Instance" then
                    N("Target", "Selected " .. fmt(p))
                end
            end
        end,
    })
    return dd
end

local function targetsOf(dd, server)
    local out = {}
    if server then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then out[#out + 1] = p end
        end
    else
        for p, on in pairs(dd.Value) do
            if on and typeof(p) == "Instance" then out[#out + 1] = p end
        end
    end
    return out
end

local function applyMethods(targetDD, methodDD, server)
    local targets = targetsOf(targetDD, server)
    if #targets == 0 then return N("Target", "No target selected.") end
    local picked = {}
    for m, on in pairs(methodDD.Value) do if on then picked[#picked + 1] = m end end
    if #picked == 0 then return N("Target", "Select a method first.") end
    Fx()
    for _, p in ipairs(targets) do
        for _, m in ipairs(picked) do
            if m:find("Kick") or m:find("Crash by Snowball") then
                KickFx(p)
            else
                N(m, "Applied to " .. fmt(p))
            end
        end
    end
end

local function TargetTab(tab, tag)
    local tg = tab:AddLeftGroupbox("Target", "circle-user-round")
    local targetDD = PlayerList(tg)
    local mg = tab:AddRightGroupbox("Method Settings", "apple")
    local methods = {}
    for _, b in ipairs({ "Kick", "Crash by Snowball", "Kill", "Void", "Bring", "Crash", "Snowball Method Crash" }) do
        for _, m in ipairs(methodList(b)) do methods[#methods + 1] = m end
    end
    local methodDD = mg:AddDropdown(id("M"), {
        Text = "Methods", Values = methods, Multi = true, AllowNull = true, Searchable = true, Callback = function() end,
    })
    local ap = tab:AddLeftGroupbox("Apply", "dock")
    ap:AddToggle(id("T"), { Text = "Loop Apply Method Selected", Tooltip = "Keeps applying selected methods to selected players",
        Callback = function(v) if v then applyMethods(targetDD, methodDD, false) else N(tag, "Loop stopped.") end end })
    ap:AddToggle(id("T"), { Text = "Loop Apply Method Server", Tooltip = "Keeps applying selected methods to all players",
        Callback = function(v) if v then applyMethods(targetDD, methodDD, true) else N(tag, "Loop stopped.") end end })
    ap:AddButton({ Text = "Apply Method Selected", Tooltip = "Applies selected methods to selected players",
        Func = function() applyMethods(targetDD, methodDD, false) end })
    ap:AddButton({ Text = "Apply Method Server", Tooltip = "Applies selected methods to every player",
        Func = function() applyMethods(targetDD, methodDD, true) end })
    return targetDD, methodDD
end

