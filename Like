    function A.announce(str, col, dur)
        if not A.big then return end
        A.ann = A.ann + 1
        local my = A.ann
        A.big.Text = str
        A.big.TextColor3 = col or WHITE
        A.big.TextSize = 18
        A.big.TextTransparency = 0
        A.big.TextStrokeTransparency = 0
        tween(A.big, 0.18, { TextSize = (#str > 14) and 30 or 48 }, Enum.EasingStyle.Back)
        task.delay(dur or 1, function()
            if A.ann == my and A.big then
                tween(A.big, 0.3, { TextTransparency = 1, TextStrokeTransparency = 1 })
            end
        end)
    end

