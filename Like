local function B(box, name, desc)
    return box:AddButton({ Text = name, Tooltip = desc, Func = function() N(name, desc) Fx() end })
end
local function S(box, name, def, min, max)
    box:AddSlider(id("S"), { Text = name, Default = def, Min = min, Max = max, Rounding = 0, Compact = true, Callback = function() end })
end
local function TV(box, base, desc)
    T(box, base, desc)
    for _, s in ipairs(SUF) do T(box, base .. s[1], desc .. " " .. s[2]) end
end
local function BV(box, base, desc)
    B(box, base, desc)
