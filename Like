        A.crowdAmp = math.max(A.crowdAmp, amp or 1)
    end

    function A.diffMul()
        local d = S.diff
        if d == "Easy" then return 0.6 end
        if d == "Hard" then return 1.5 end
        if d == "Impossible" then return 2.5 end
        return 1
    end

    function A.fire(x1, y1, x2, y2, col, dur, onHit, big, trail)
        if not A.stage then return end
        local sz = big and 18 or 12
        if trail then sz = 30 end
        local p = circle(sz, col or S.snowColor, A.stage)
        p.AnchorPoint = Vector2.new(0.5, 0.5)
        p.ZIndex = 8
        task.spawn(function()
            local t0 = os.clock()
            local n = 0
            while A.alive do
                local a = (os.clock() - t0) / dur
                if a >= 1 then break end
                local x = x1 + (x2 - x1) * a
                local y = y1 + (y2 - y1) * a - math.sin(a * math.pi) * 46
                p.Position = UDim2.fromOffset(x, y)
                n = n + 1
                if trail and n % 3 == 0 then
                    local t = circle(14, WHITE, A.stage)
                    t.AnchorPoint = Vector2.new(0.5, 0.5)
                    t.Position = UDim2.fromOffset(x, y)
                    t.ZIndex = 7
                    tween(t, 0.3, { BackgroundTransparency = 1, Size = UDim2.fromOffset(4, 4) })
                    task.delay(0.35, function() t:Destroy() end)
                end
                RunService.Heartbeat:Wait()
            end
            p:Destroy()
            if A.alive and onHit then
                onHit()
            end
        end)
    end

    function A.travel()
        return math.clamp(1.15 - S.speed * 0.09, 0.2, 1.1)
    end

