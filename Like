    function A.shakeAhmad(mag, dur)
        if not A.ah then return end
        A.shake = A.shake + 1
        local my = A.shake
        task.spawn(function()
            local t0 = os.clock()
            while A.alive and A.shake == my and os.clock() - t0 < dur do
                A.ah.Position = UDim2.fromOffset(A.base.X + rnd(-mag, mag), A.base.Y + rnd(-math.floor(mag / 2), 0))
                RunService.Heartbeat:Wait()
            end
            if A.alive and A.shake == my and A.ah then
                A.ah.Position = UDim2.fromOffset(A.base.X, A.base.Y)
            end
        end)
    end

    function A.shakeStage(mag, dur)
        if not A.stage then return end
        task.spawn(function()
            local t0 = os.clock()
            while A.alive and os.clock() - t0 < dur do
                A.stage.Position = UDim2.fromOffset(8 + rnd(-mag, mag), 90 + rnd(-mag, mag))
                RunService.Heartbeat:Wait()
            end
            if A.stage then
                A.stage.Position = UDim2.fromOffset(8, 90)
            end
        end)
    end

