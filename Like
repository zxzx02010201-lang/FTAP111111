    function A.start()
        A.build()
        A.applyBall("Classic")

        track(RunService.Heartbeat:Connect(function()
            local now = os.clock()
            A.gaspAmp = (A.gaspAmp or 0) * 0.96
            for i, g in ipairs(A.gallery) do
                local off = math.sin(now * 2 + i) * 1.5 - (A.gaspAmp or 0) * math.abs(math.sin(now * 10 + i)) * 10
                g.g.Position = UDim2.fromOffset(g.x, 232 + off)
            end
            for i, j in ipairs(A.jury) do
                local vis = i <= S.jury
                j.b.Visible = vis
                j.h.Visible = vis
                j.c.Visible = vis
            end
            if A.seal then
                A.seal.Visible = S.seal
            end
            if A.stroke then
                local k = (math.sin(now * 3) + 1) / 2
                A.stroke.Color = Color3.fromRGB(100 + math.floor(100 * k), 36, 26)
            end
            if A.sb then
                A.sb.Position = UDim2.fromOffset(548, 148 + math.sin(now * 4) * 3)
            end
        end))

        task.spawn(function()
            while A.alive do
                if S.auto and A.root and A.root.Visible and not A.crashed and not A.lineBusy then
                    A.battleStep()
                end
                task.wait(1 / math.max(S.tempo, 0.5) + 1)
            end
        end)

        task.spawn(function()
            while A.alive do
                task.wait(3)
                A.subIdx = A.subIdx % #SUBS + 1
                local b = SUBS[A.subIdx]
                A.setBanner(b[1], b[2])
            end
        end)

        task.spawn(function()
            while A.alive do
                task.wait(3.5)
                if A.tick and A.tick.Visible and not A.lineBusy then
                    A.comment(REPORTER[rnd(1, #REPORTER)])
                end
            end
        end)

        task.spawn(function()
            while A.alive do
                task.wait(math.max(2, 14 - S.patience / 8))
                if not A.crashed then
                    A.judgeSay()
                    if S.patience < 30 then
                        A.gavel(1)
                    end
                end
            end
        end)

        task.spawn(function()
            while A.alive do
                task.wait(7)
                if S.lcLoop then
                    A.runVersion("Random")
                end
            end
        end)

        task.spawn(function()
            while A.alive do
                task.wait(4.5)
                if S.autoExcuse and not A.crashed then
                    A.excuse()
                end
            end
        end)

        task.spawn(function()
            while A.alive do
                task.wait(0.2)
                if S.tears > 0 and not A.crashed then
                    for _ = 1, S.tears do
                        local t = circle(5, ICE, A.scene)
                        t.Position = UDim2.fromOffset(A.base.X + rnd(-14, 10), A.base.Y - 98)
                        t.ZIndex = 9
                        tween(t, 0.7, { Position = UDim2.fromOffset(t.Position.X.Offset + rnd(-10, 10), A.base.Y - 6), BackgroundTransparency = 1 })
                        task.delay(0.75, function() t:Destroy() end)
                    end
                end
            end
        end)

        task.delay(0.6, function()
            A.announce("ALL RISE", WHITE, 1)
            A.gavel(2)
            A.speak(A.judge, "court is now in session")
        end)
end

