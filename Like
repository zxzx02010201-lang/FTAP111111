        A.attackSnowman()
    elseif m == "Ahmad_HCK vs Snowball" then
        A.attackAhmad()
    else
        local r = math.random(1, 4)
        if r == 1 then A.attackSnowman()
        elseif r == 2 then A.attackBall(true)
        elseif r == 3 then A.attackBall(false)
        else A.attackAhmad() end
    end
