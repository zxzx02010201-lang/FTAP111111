    function A.hit(dmg, label)
        if not A.alive or A.crashed then return end
        dmg = math.floor(dmg * A.diffMul())
        if S.immunity then
            dmg = dmg * 2
            label = "IMMUNITY X  -" .. dmg
        end
        if A.shieldUp and S.shield then
            A.shieldUp = false
            A.shield.Visible = false
            A.pop("ANTI-SNOWBALL BROKEN", A.base.X, A.base.Y - 130, PINK, 12)
            A.say("anti-snowball was ON??")
        end
        if S.diff == "Easy" and rnd(1, 4) == 1 then
            A.sbSay("holding back lol")
        elseif S.diff == "Impossible" and rnd(1, 4) == 1 then
            A.sbSay("not even trying")
        end
        A.hits = A.hits + 1
        A.combo.Text = A.hits .. " HITS"
        A.combo.TextSize = 30
        tween(A.combo, 0.25, { TextSize = 20 }, Enum.EasingStyle.Back)
        A.rage = math.min(100, A.rage + 7)
        A.setRage()
        if A.rage >= 100 then
            A.pop("RAGE FULL (still loses)", A.base.X, A.base.Y - 145, RED, 12)
            A.rage = 0
            A.setRage()
        end
        A.setHP(A.hp - dmg)
        A.face.Text = ">_<"
        A.shakeAhmad(math.clamp(4 + math.floor(dmg / 4), 4, 14), 0.3)
        A.pop(label or ("-" .. dmg), A.base.X, A.base.Y - 100, WHITE, 18)
        A.pop(POPS[rnd(1, #POPS)], A.base.X + rnd(-30, 30), A.base.Y - 70, RED, 14)
        A.crowdJump(1.2)
        A.lagFx()
        A.updateScore()
        task.delay(0.3, function()
            if A.face and not A.crashed then A.face.Text = "O_O" end
        end)
        if A.hp <= 0 then
            A.crash()
        end
    end

