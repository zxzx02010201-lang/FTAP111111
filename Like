function A.shakeAhmad(mag, dur)
    if not A.ah then return end
    A.shake = A.shake + 1
    local my = A.shake
    task.spawn(function()
        local t0 = os.clock()
        while A.alive and A.shake == my and os.clock() - t0 < dur do
            A.ah.Position = UDim2.fromOffset(A.base.X + wr(-mag, mag), A.base.Y + wr(-math.floor(mag / 2), 0))
            RunService.Heartbeat:Wait()
        end
        if A.alive and A.shake == my and A.ah then
            A.ah.Position = UDim2.fromOffset(A.base.X, A.base.Y)
        end
    end)
end

function A.shakeRoot(mag, dur)
    if not A.stage then return end
    task.spawn(function()
        local t0 = os.clock()
        while A.alive and os.clock() - t0 < dur do
            A.stage.Position = UDim2.fromOffset(8 + wr(-mag, mag), 60 + wr(-mag, mag))
            RunService.Heartbeat:Wait()
        end
        if A.stage then
            A.stage.Position = UDim2.fromOffset(8, 60)
        end
    end)
end

function A.setHP(v)
    A.hp = math.clamp(v, 0, 100)
    if A.hpfill then
        tween(A.hpfill, 0.2, { Size = UDim2.fromOffset(64 * A.hp / 100, 6) })
    end
end

function A.fire(x1, y1, x2, y2, col, dur, onHit, big)
    if not A.stage then return end
    local sz = big and 18 or 12
    local p = circle(sz, col or SW.snowColor, A.stage)
    p.AnchorPoint = Vector2.new(0.5, 0.5)
    p.ZIndex = 6
    task.spawn(function()
        local t0 = os.clock()
        while A.alive do
            local a = (os.clock() - t0) / dur
            if a >= 1 then break end
            local x = x1 + (x2 - x1) * a
            local y = y1 + (y2 - y1) * a - math.sin(a * math.pi) * 46
            p.Position = UDim2.fromOffset(x, y)
            RunService.Heartbeat:Wait()
        end
        p:Destroy()
        if A.alive and onHit then
            onHit()
        end
    end)
end

function A.travel()
    return math.clamp(1.15 - SW.speed * 0.09, 0.2, 1.1)
end

function A.lagFx()
    if math.random(1, 100) > SW.lag then return end
    local st = SW.lagStyle
    if st == "Rubberband" then
        A.base = Vector2.new(A.base.X + 40, A.base.Y)
        A.ah.Position = UDim2.fromOffset(A.base.X, A.base.Y)
        A.pop("RUBBERBAND", A.base.X, A.base.Y - 110, Color3.fromRGB(255, 160, 160), 12)
        task.delay(0.35, function()
            if not A.alive then return end
            A.base = Vector2.new(110, 204)
            tween(A.ah, 0.3, { Position = UDim2.fromOffset(110, 204) }, Enum.EasingStyle.Back)
        end)
    elseif st == "Freeze" then
        A.face.Text = "..."
        A.body.Rotation = 0
        A.pop("FROZEN (lag)", A.base.X, A.base.Y - 110, Color3.fromRGB(190, 220, 255), 12)
        task.delay(0.6, function()
            if A.face and not A.crashed then A.face.Text = "O_O" end
        end)
    elseif st == "Teleport Back" then
        A.base = Vector2.new(60, 204)
        A.ah.Position = UDim2.fromOffset(60, 204)
        A.pop("TP BACK", 60, 90, Color3.fromRGB(255, 120, 120), 12)
        task.delay(0.25, function()
            if not A.alive then return end
            A.base = Vector2.new(110, 204)
            A.ah.Position = UDim2.fromOffset(110, 204)
        end)
    else
        A.ping.Text = "ping 9999ms"
        A.ping.TextColor3 = RED
        task.delay(1.2, function()
            if A.ping then
                A.ping.Text = SW.noLineLag and "ping 9999ms" or "ping 12ms"
                A.ping.TextColor3 = Color3.fromRGB(255, 180, 180)
            end
        end)
    end
end

function A.hit(dmg, label)
    if not A.alive or A.crashed then return end
    if SW.immunity then
        dmg = dmg * 2
        label = "IMMUNITY X  -" .. dmg
    end
    if A.shieldUp and SW.shield then
        A.shieldUp = false
        A.shield.Visible = false
        A.pop("ANTI-SNOWBALL BROKEN", A.base.X, A.base.Y - 120, Color3.fromRGB(255, 200, 80), 12)
        A.doFlash(Color3.fromRGB(255, 80, 80), 0.25)
        A.say("anti-snowball was ON??")
    end
    A.scoreS = A.scoreS + 1
    A.setHP(A.hp - dmg)
    A.face.Text = ">_<"
    A.shakeAhmad(math.clamp(4 + math.floor(dmg / 4), 4, 14), 0.3)
    A.pop(label or ("-" .. dmg), A.base.X, A.base.Y - 100, Color3.fromRGB(255, 255, 255), 18)
    A.pop(POPS[wr(1, #POPS)], A.base.X + wr(-30, 30), A.base.Y - 70, RED, 14)
    A.lagFx()
    A.updateScore()
    task.delay(0.3, function()
        if A.face and not A.crashed then A.face.Text = "O_O" end
    end)
    if A.hp <= 0 then
        A.crash()
    end
end

function A.crash()
    if A.crashed or not A.alive then return end
    A.crashed = true
    A.crashes = A.crashes + 1
    A.face.Text = "X_X"
    tween(A.body, 0.35, { Rotation = 90 }, Enum.EasingStyle.Bounce)
    A.setBanner("AHMAD CRASH BY SNOWBALL", RED)
    A.doFlash(Color3.new(1, 1, 1), 0.5)
    A.shakeRoot(5, 0.4)
    A.dlg.Visible = true
    A.pop("CRASHED", A.base.X, A.base.Y - 100, RED, 22)
    A.updateScore()
    task.delay(2.2, function()
        if not A.alive then return end
        A.dlg.Visible = false
        A.revive(true)
    end)
end

