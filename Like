        local N = { cat = "All", custom = "", speed = 3, x = 524, w = 0, auto = true, seq = 0 }

        local function headline()
            if N.custom ~= "" and rnd(1, 3) == 1 then
                return N.custom
            end
            local list = {}
            if N.cat == "All" then
