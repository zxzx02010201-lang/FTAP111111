    function A.setFlakes(n)
        local f = A.flakes
        while #f > n do
            local o = table.remove(f)
            o.f:Destroy()
        end
        while #f < n do
            local sz = rnd(2, 5)
            local fl = circle(sz, S.snowColor, A.stage)
            fl.Position = UDim2.fromOffset(rnd(0, A.W), rnd(0, A.H))
            fl.ZIndex = 1
            table.insert(f, { f = fl, v = rnd(18, 50), d = (math.random() - 0.5) * 20 })
        end
    end

