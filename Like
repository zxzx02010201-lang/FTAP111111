    function A.start()
        A.build()
        A.setFlakes(S.snowCount)
        A.applyBall("Classic")
        A.setChant("AHMAD L")

        track(RunService.Heartbeat:Connect(function(dt)
            for _, o in ipairs(A.flakes) do
                local p = o.f.Position
                local y = p.Y.Offset + o.v * dt
                local x = p.X.Offset + o.d * dt
                if y > A.H then
                    y = -6
                    x = rnd(0, A.W)
                end
                o.f.Position = UDim2.fromOffset(x, y)
            end
            local now = os.clock()
            A.crowdAmp = A.crowdAmp * 0.96
            for i, c in ipairs(A.crowd) do
                local off = math.sin(now * 3 + i) * 2 - A.crowdAmp * math.abs(math.sin(now * 12 + i)) * 12
                c.b.Position = UDim2.fromOffset(c.x, 168 + off)
                c.h.Position = UDim2.fromOffset(c.x + 2, 157 + off)
                c.t.Position = UDim2.fromOffset(c.x + 4, 154 + off)
            end
            if A.ball and not A.rolling then
                A.sb.Position = UDim2.fromOffset(A.ballBase.X, A.ballBase.Y + math.sin(now * 4) * 3)
            end
            if A.stroke then
                local k = (math.sin(now * 3) + 1) / 2
                A.stroke.Color = Color3.fromRGB(150 + math.floor(105 * k), 20, 20)
            end
        end))

        task.spawn(function()
            while A.alive do
                if S.auto and A.root and A.root.Visible and not A.crashed and not A.lineBusy and not A.comboBusy then
                    A.battleStep()
                end
                task.wait(1 / math.max(S.rate, 0.5) + 0.25)
            end
        end)

        task.spawn(function()
            while A.alive do
                task.wait(1)
                if not A.crashed then
                    A.time = A.time - 1
                    if A.time <= 0 then
                        A.time = 99
                        A.pop("TIME UP - Ahmad still loses", A.W / 2, 110, WHITE, 16)
                    end
                    A.timer.Text = string.format("%02d", A.time)
                end
            end
        end)

        task.spawn(function()
            while A.alive do
                task.wait(3)
                A.subIdx = A.subIdx % #SUBS + 1
                local b = SUBS[A.subIdx]
                A.setSub(b[1], b[2])
            end
        end)

        task.spawn(function()
            while A.alive do
                task.wait(3.5)
                if A.tick and A.tick.Visible and not A.lineBusy then
                    A.comment(COMMENTS[rnd(1, #COMMENTS)])
                end
                if A.sb and not A.crashed then
                    A.sbSay(TAUNTS[rnd(1, #TAUNTS)])
                end
            end
        end)

        task.spawn(function()
            while A.alive do
                task.wait(7)
                if S.lcLoop then
                    A.runVersion("Random")
                end
            end
        end)

        task.spawn(function()
            while A.alive do
                task.wait(4.5)
                if S.autoExcuse and not A.crashed then
                    A.excuse()
                end
            end
        end)

        task.spawn(function()
            while A.alive do
                task.wait(0.2)
                if S.tears > 0 and not A.crashed then
                    for i = 1, S.tears do
                        local t = circle(5, ICE, A.stage)
                        t.Position = UDim2.fromOffset(A.base.X + rnd(-14, 10), A.base.Y - 98)
                        t.ZIndex = 9
                        tween(t, 0.7, { Position = UDim2.fromOffset(t.Position.X.Offset + rnd(-10, 10), A.base.Y - 6), BackgroundTransparency = 1 })
                        task.delay(0.75, function() t:Destroy() end)
                    end
                end
            end
        end)

        task.delay(0.6, function()
            A.announce("ROUND 1", WHITE, 0.8)
            task.delay(0.9, function()
                A.announce("FIGHT!", RED, 0.7)
            end)
        end)
    end

