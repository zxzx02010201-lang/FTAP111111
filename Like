    local function buildBracket()
        local Brk = panel("Bracket", "HUB TOURNAMENT  |  FINALS", Vector2.new(0, 0), UDim2.new(0, 12, 0, 410), 396, 236, GOLD, Color3.fromRGB(16, 12, 4))
        local BB = Brk.body
        local TEAMS = { "Ahmad_HCK", "Snowball", "Summer Hub", "Skid Hub", "Lag Hub", "PCLD", "Snowman", "Anti-Snow" }
        local counts = { 8, 4, 2, 1 }
        local slots, ys = {}, {}
        local LINE = GOLD:Lerp(DARK, 0.55)
        local IDLE = Color3.fromRGB(40, 30, 10)

        for c = 1, 4 do
            slots[c] = {}
            ys[c] = {}
            for i = 1, counts[c] do
                local y
                if c == 1 then
                    y = 6 + (i - 1) * 25
                else
                    y = (ys[c - 1][2 * i - 1] + ys[c - 1][2 * i]) / 2
                end
                ys[c][i] = y
                local x = 8 + (c - 1) * 98
                local f = rect(BB, x, y, 88, 20, IDLE)
                corner(f, 4)
                local t = label(f, "?", 11, WHITE, 0, 0, 88, 20, Enum.TextXAlignment.Center)
                slots[c][i] = { f = f, t = t, name = nil }
            end
        end

        for c = 2, 4 do
            for i = 1, counts[c] do
                local y1 = ys[c - 1][2 * i - 1] + 10
                local y2 = ys[c - 1][2 * i] + 10
                local xr = 8 + (c - 2) * 98 + 88
                local xl = 8 + (c - 1) * 98
                rect(BB, xr, y1, 6, 2, LINE)
                rect(BB, xr, y2, 6, 2, LINE)
                rect(BB, xr + 4, y1, 2, y2 - y1 + 2, LINE)
                rect(BB, xr + 6, ys[c][i] + 9, xl - xr - 6, 2, LINE)
            end
        end

        local crown = label(BB, "", 12, GOLD, 302, ys[4][1] - 18, 88, 16, Enum.TextXAlignment.Center, Enum.Font.GothamBlack)
        local outLbl = label(BB, "", 10, Color3.fromRGB(255, 170, 170), 298, ys[4][1] + 26, 96, 28, Enum.TextXAlignment.Center)
        outLbl.TextWrapped = true

        local B = { champ = "Summer Hub", busy = false, auto = true }

        local function setSlot(c, i, name, state)
            local s = slots[c][i]
            s.name = name
            s.t.Text = name or "?"
            s.f.BackgroundColor3 = (state == "win") and GOLD:Lerp(DARK, 0.45) or (state == "lose") and Color3.fromRGB(30, 14, 14) or IDLE
            s.t.TextColor3 = (state == "lose") and Color3.fromRGB(140, 110, 110) or WHITE
        end

        local function reset()
            for c = 1, 4 do
                for i = 1, counts[c] do
                    setSlot(c, i, nil, nil)
                end
            end
            for i = 1, 8 do
                setSlot(1, i, TEAMS[i], nil)
            end
            crown.Text = ""
            outLbl.Text = ""
        end

        local function pick(a, b)
            if a == B.champ then
                return a
            end
            if b == B.champ then
                return b
            end
            if a == "Ahmad_HCK" then
                return b
            end
            if b == "Ahmad_HCK" then
                return a
            end
            return (rnd(1, 2) == 1) and a or b
        end

        local function run()
            if B.busy then
                return
            end
            B.busy = true
            reset()
            task.wait(0.5)
            for c = 2, 4 do
                for i = 1, counts[c] do
                    local a = slots[c - 1][2 * i - 1]
                    local b = slots[c - 1][2 * i]
                    local w = pick(a.name, b.name)
                    setSlot(c - 1, 2 * i - 1, a.name, (w == a.name) and "win" or "lose")
                    setSlot(c - 1, 2 * i, b.name, (w == b.name) and "win" or "lose")
                    setSlot(c, i, w, nil)
                end
                task.wait(0.7)
            end
            setSlot(4, 1, slots[4][1].name, "win")
            crown.Text = "CHAMPION"
            outLbl.Text = "Ahmad_HCK: 0 wins, 9999 excuses"
            B.busy = false
        end

        reset()

        task.spawn(function()
            task.wait(1.5)
            while OV.alive do
                if B.auto and Brk.root.Visible then
                    run()
                end
                task.wait(9)
            end
        end)

        regArena("Hub Bracket", Brk.root, "B_Show")

        local g = Tabs.Home:AddLeftGroupbox("Bracket: Hub Tournament", "trophy")
        g:AddToggle("B_Show", {
            Text = "Show Tournament Bracket",
            Default = true,
            Callback = function(v) Brk.root.Visible = v end,
        })
        g:AddToggle("B_Auto", {
            Text = "Auto Tournament",
            Default = true,
            Callback = function(v) B.auto = v end,
        })
        g:AddDropdown("B_Champ", {
            Text = "Forced Champion",
            Values = { "Summer Hub", "Snowball", "Snowman", "PCLD", "Skid Hub", "Lag Hub", "Anti-Snow" },
            Default = 1,
            Callback = function(v) B.champ = v end,
        })
        g:AddButton({ Text = "Simulate Tournament", Func = function() task.spawn(run) end })
        g:AddButton({ Text = "Reset Bracket", Func = function()
            if not B.busy then
                reset()
            end
        end })
    end

    local function buildCasino()
        local Cas = panel("Casino", "LAG JACKPOT CASINO", Vector2.new(1, 0), UDim2.new(1, -12, 0, 404), 300, 196, VIOLET, Color3.fromRGB(12, 5, 18))
        local CB = Cas.body
        local SYMS = { "LAG", "L", "SNOW", "CRASH", "7", "PCLD" }
        local reels = {}
        for i = 1, 3 do
            local f = rect(CB, 14 + (i - 1) * 94, 8, 84, 58, Color3.fromRGB(28, 14, 40))
            corner(f, 8)
            stroke(f, VIOLET, 2)
            reels[i] = label(f, SYMS[i], 22, WHITE, 0, 0, 84, 58, Enum.TextXAlignment.Center, Enum.Font.GothamBlack)
        end
        local credits = label(CB, "AHMAD CREDITS: 1000", 13, GOLD, 14, 74, 272, 18, Enum.TextXAlignment.Center)
        local msg = label(CB, "pull the lever, Ahmad", 12, Color3.fromRGB(210, 190, 235), 14, 94, 272, 18, Enum.TextXAlignment.Center)
        local btn = new("TextButton", {
            Position = UDim2.fromOffset(14, 120),
            Size = UDim2.fromOffset(272, 40),
            BackgroundColor3 = VIOLET,
            BorderSizePixel = 0,
            Text = "SPIN  (-10)",
            TextColor3 = WHITE,
            TextSize = 16,
            Font = Enum.Font.GothamBlack,
        }, CB)
        corner(btn, 8)

        local X = { credits = 1000, busy = false, auto = true, mode = "Rigged vs Ahmad" }

        local function setCredits(v)
            X.credits = v
            credits.Text = "AHMAD CREDITS: " .. tostring(v)
        end

        local function roll()
            local out = {}
            if X.mode == "Fair" then
                for i = 1, 3 do
                    out[i] = SYMS[rnd(1, #SYMS)]
                end
            elseif X.mode == "Jackpot" then
                local s = SYMS[rnd(1, #SYMS)]
                out = { s, s, s }
            else
                local s = SYMS[rnd(1, #SYMS)]
                local o = s
                while o == s do
                    o = SYMS[rnd(1, #SYMS)]
                end
                out = { s, s, o }
                local p = rnd(1, 3)
                out[p], out[3] = out[3], out[p]
            end
            return out
        end

        local function spin()
            if X.busy then
                return
            end
            X.busy = true
            if X.credits < 10 then
                setCredits(1000)
            end
            setCredits(X.credits - 10)
            msg.Text = "spinning..."
            local out = roll()
            for i = 1, 3 do
                task.spawn(function()
                    local t0 = os.clock()
                    local dur = 0.8 + i * 0.5
                    while os.clock() - t0 < dur and OV.alive do
                        reels[i].Text = SYMS[rnd(1, #SYMS)]
                        task.wait(0.06)
                    end
                    reels[i].Text = out[i]
                end)
            end
            task.wait(2.5)
            if out[1] == out[2] and out[2] == out[3] then
                setCredits(X.credits + 250)
                msg.Text = "JACKPOT: " .. out[1] .. " x3  (+250)"
            elseif out[1] == out[2] or out[2] == out[3] or out[1] == out[3] then
                msg.Text = "so close. skill issue."
            else
                msg.Text = "ratio. Ahmad loses again."
            end
            X.busy = false
        end

        track(btn.MouseButton1Click:Connect(function()
            task.spawn(spin)
        end))

        task.spawn(function()
            task.wait(3)
            while OV.alive do
                if X.auto and Cas.root.Visible then
                    spin()
                end
                task.wait(6)
            end
        end)

        regArena("Lag Casino", Cas.root, "X_Show")

        local g = Tabs.Home:AddRightGroupbox("Casino: Lag Jackpot", "dices")
        g:AddToggle("X_Show", {
            Text = "Show Lag Casino",
            Default = true,
            Callback = function(v) Cas.root.Visible = v end,
        })
        g:AddToggle("X_Auto", {
            Text = "Auto Spin",
            Default = true,
            Callback = function(v) X.auto = v end,
        })
        g:AddDropdown("X_Mode", {
            Text = "House Mode",
            Values = { "Rigged vs Ahmad", "Fair", "Jackpot" },
            Default = 1,
            Callback = function(v) X.mode = v end,
        })
        g:AddButton({ Text = "Spin Now", Func = function() task.spawn(spin) end })
        g:AddButton({ Text = "Reset Credits", Func = function() setCredits(1000) end })
    end

    buildNews()
    buildVitals()
    buildBracket()
    buildCasino()

    pcall(function()
        Library:OnUnload(function()
            OV.alive = false
            for _, c in ipairs(OV.conns) do
                pcall(function() c:Disconnect() end)
            end
            if OV.gui then
                pcall(function() OV.gui:Destroy() end)
            end
        end)
    end)
end

