    function A.fire(x1, y1, x2, y2, col, dur, onHit, big)
        if not A.scene then return end
        local p = circle(big and 18 or 12, col or SNOW, A.scene)
        p.AnchorPoint = Vector2.new(0.5, 0.5)
        p.ZIndex = 20
        task.spawn(function()
            local t0 = os.clock()
            while A.alive do
                local a = (os.clock() - t0) / dur
                if a >= 1 then break end
                local x = x1 + (x2 - x1) * a
                local y = y1 + (y2 - y1) * a - math.sin(a * math.pi) * 40
                p.Position = UDim2.fromOffset(x, y)
                RunService.Heartbeat:Wait()
            end
            p:Destroy()
            if A.alive and onHit then
                onHit()
            end
        end)
end

