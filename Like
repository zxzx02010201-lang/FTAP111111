local removed, killConns = {}, {}
local function hidePlayer(p) if p.Character then p.Character:Destroy() end end
local function KickFx(p)
    Library:Notify({
        Title = "Summerhub", Description = "Kicked Player\n" .. fmt(p) .. " has been kicked.",
        Time = 5, BigIcon = ICON, IconColor = ACCENT,
    })
    removed[p] = true
    task.delay(1, function() hidePlayer(p) end)
    if not killConns[p] then
        killConns[p] = p.CharacterAdded:Connect(function()
            if removed[p] then task.wait() hidePlayer(p) end
        end)
    end
end
Players.PlayerRemoving:Connect(function(p)
    removed[p] = nil
