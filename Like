        local ping = label(VB, "PING 9999ms", 12, WHITE, 214, 62, 104, 16)
        label(VB, "SKILL 0%", 12, WHITE, 214, 80, 104, 16)
        label(VB, "LAG 100%", 12, RED, 214, 98, 104, 16)
        local status = label(VB, "STATUS: CRITICAL (LAG 100%)", 12, GREEN, 8, 128, 304, 18, Enum.TextXAlignment.Center)

        local V = { hr = 96, base = 96, flat = false, ping = 9999, phase = 0, acc = 0, token = 0 }

        local function gauss(t, c, w, a)
            return a * math.exp(-((t - c) / w) ^ 2)
        end

        local function ecg(t)
            return gauss(t, 0.15, 0.04, 0.18) + gauss(t, 0.27, 0.012, -0.2) + gauss(t, 0.30, 0.012, 1) + gauss(t, 0.33, 0.014, -0.35) + gauss(t, 0.56, 0.07, 0.3)
        end

        local function beat()
            scrStroke.Color = WHITE
            tween(scrStroke, 0.25, { Color = DIMG })
        end

        track(RunService.Heartbeat:Connect(function(dt)
            if not Vit.root.Visible then
                return
            end
            V.acc = V.acc + dt
            local step = 1 / 30
            local moved = false
            while V.acc >= step do
                V.acc = V.acc - step
                local v
                if V.flat then
                    v = (math.random() - 0.5) * 0.04
                else
                    local before = V.phase
                    V.phase = V.phase + step * V.hr / 60
                    if math.floor(V.phase) > math.floor(before) then
                        beat()
                    end
                    v = ecg(V.phase % 1) + (math.random() - 0.5) * 0.03
                end
                table.remove(buf, 1)
                table.insert(buf, v)
                moved = true
            end
            if moved then
                for i = 1, COLS do
                    local a = buf[i]
                    local b = buf[i - 1] or a
                    cols[i].Position = UDim2.fromOffset((i - 1) * 4, 58 - math.max(a, b) * 50)
                    cols[i].Size = UDim2.fromOffset(4, math.max(3, math.abs(a - b) * 50 + 2))
                end
            end
        end))

        task.spawn(function()
            while OV.alive do
                if V.flat then
                    hrVal.Text = "0"
                    hrVal.TextColor3 = RED
                    status.Text = "STATUS: FLATLINE"
                    status.TextColor3 = RED
                else
                    hrVal.Text = tostring(math.floor(V.hr + rnd(-2, 2)))
                    local hot = V.hr >= 170
                    hrVal.TextColor3 = hot and RED or GREEN
                    status.Text = hot and "STATUS: PANIC (SNOWBALL INCOMING)" or "STATUS: CRITICAL (LAG 100%)"
                    status.TextColor3 = hot and RED or GREEN
                end
                ping.Text = "PING " .. tostring(V.ping) .. "ms"
                task.wait(0.25)
            end
        end)

        local function defib()
            V.token = V.token + 1
            V.flat = false
            V.hr = V.base
            status.Text = "CLEAR!  (Ahmad is back, sadly)"
            scrStroke.Color = RED
            tween(scrStroke, 0.6, { Color = DIMG })
        end

        local function panicSpike()
            V.token = V.token + 1
            local my = V.token
            V.flat = false
            V.hr = 220
            task.delay(4, function()
                if my == V.token then
                    V.hr = V.base
                end
            end)
        end

